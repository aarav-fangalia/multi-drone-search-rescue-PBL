
#include <iostream>
#include <vector>
#include <queue>
#include <string>
#include <algorithm>
#include <climits>
#include <functional>
using namespace std;

// ---------- UAV CLASS ----------
class UAV {
public:
    string id;
    int location;
    int battery;
    bool available;

    UAV(string i, int loc, int bat) {
        id = i;
        location = loc;
        battery = bat;
        available = true;
    }
};

// ---------- MISSION CLASS ----------
class Mission {
public:
    int id;
    int destination;
    int priority;
    string type;
    string status;

    Mission(int i, int dest, int p, string t) {
        id = i;
        destination = dest;
        priority = p;
        type = t;
        status = "Pending";
    }
};

// Highest priority mission comes first
struct CompareMission {
    bool operator()(Mission a, Mission b) {
        return a.priority < b.priority;
    }
};

// ---------- GRAPH CLASS ----------
class Graph {
    int V;
    vector<vector<pair<int, int>>> adj;

public:
    Graph(int v) {
        V = v;
        adj.resize(V + 1);
    }

    void addEdge(int u, int v, int w) {
        adj[u].push_back({v, w});
        adj[v].push_back({u, w});
    }

    // Dijkstra: shortest distance and path
    pair<int, vector<int>> shortestPath(int src, int dest) {
        vector<int> dist(V + 1, INT_MAX);
        vector<int> parent(V + 1, -1);

        priority_queue<
            pair<int, int>,
            vector<pair<int, int>>,
            greater<pair<int, int>>
        > pq;

        dist[src] = 0;
        pq.push({0, src});

        while (!pq.empty()) {
            int d = pq.top().first;
            int u = pq.top().second;
            pq.pop();

            if (d != dist[u])
                continue;

            for (auto edge : adj[u]) {
                int v = edge.first;
                int w = edge.second;

                if (dist[u] + w < dist[v]) {
                    dist[v] = dist[u] + w;
                    parent[v] = u;
                    pq.push({dist[v], v});
                }
            }
        }

        vector<int> path;

        if (dist[dest] == INT_MAX)
            return {-1, path};

        for (int v = dest; v != -1; v = parent[v])
            path.push_back(v);

        reverse(path.begin(), path.end());
        return {dist[dest], path};
    }
};

// ---------- COORDINATOR CLASS ----------
class Coordinator {
    vector<UAV> drones;
    Graph &graph;
    priority_queue<Mission, vector<Mission>, CompareMission> missions;

public:
    Coordinator(Graph &g) : graph(g) {}

    void addUAV(UAV u) {
        drones.push_back(u);
    }

    void addMission(Mission m) {
        missions.push(m);
    }

    void showDrones() {
        cout << "\n========== UAV STATUS ==========\n";

        for (const auto &u : drones) {
            cout << u.id
                 << " | Location: " << u.location
                 << " | Battery: " << u.battery << "%"
                 << " | Status: "
                 << (u.available ? "Available" : "Unavailable")
                 << '\n';
        }
    }

    void processMissions() {
        cout << "\n======= MISSION ALLOCATION =======\n";

        while (!missions.empty()) {
            Mission m = missions.top();
            missions.pop();

            cout << "\nMission M-" << m.id
                 << " | " << m.type
                 << " | Priority: " << m.priority << "/5\n";

            int best = -1;
            int bestDistance = INT_MAX;
            vector<int> bestPath;

            // Select the nearest eligible UAV.
            // Battery rule: battery must be at least
            // 10% per route-cost unit.
            for (int i = 0; i < (int)drones.size(); i++) {
                UAV &u = drones[i];

                if (!u.available || u.battery <= 0)
                    continue;

                auto result =
                    graph.shortestPath(u.location, m.destination);

                int distance = result.first;

                if (distance == -1) {
                    cout << "  " << u.id
                         << ": No route available.\n";
                    continue;
                }

                int requiredBattery = distance * 10;

                cout << "  " << u.id
                     << ": Distance = " << distance
                     << ", Battery = " << u.battery << "%"
                     << ", Required = " << requiredBattery << "%\n";

                if (u.battery >= requiredBattery &&
                    distance < bestDistance) {
                    best = i;
                    bestDistance = distance;
                    bestPath = result.second;
                }
            }

            if (best == -1) {
                cout << "  RESULT: No suitable UAV found.\n";
                cout << "  Mission remains unassigned.\n";
                continue;
            }

            UAV &u = drones[best];

            cout << "  Assigned UAV: " << u.id << '\n';
            cout << "  Shortest Path: ";

            for (int i = 0; i < (int)bestPath.size(); i++) {
                cout << bestPath[i];

                if (i + 1 < (int)bestPath.size())
                    cout << " -> ";
            }

            cout << "\n  Total Distance: " << bestDistance << '\n';

            int batteryUsed = bestDistance * 10;
            u.battery -= batteryUsed;
            u.location = m.destination;
            u.available = false;
            m.status = "Assigned";

            cout << "  Battery after assignment: "
                 << u.battery << "%\n";
            cout << "  Mission Status: " << m.status << '\n';
        }
    }

    void simulateLowBattery(string id, int battery) {
        for (auto &u : drones) {
            if (u.id == id) {
                u.battery = battery;
                if (battery < 30)
                    u.available = false;

                cout << "\n[EVENT] " << id
                     << " battery reduced to " << battery << "%.\n";

                if (!u.available)
                    cout << "[ALERT] " << id
                         << " is unavailable due to low battery.\n";
                return;
            }
        }
    }

    void simulateFailure(string id) {
        for (auto &u : drones) {
            if (u.id == id) {
                u.available = false;
                cout << "\n[EVENT] " << id << " has failed.\n";
                cout << "[ALERT] " << id
                     << " removed from available UAVs.\n";
                return;
            }
        }
    }
};

// ---------- MAIN ----------
int main() {
    cout << "========================================\n";
    cout << " MULTI-DRONE SEARCH & RESCUE SYSTEM\n";
    cout << "========================================\n";

    // Disaster area: nodes 1 to 6
    Graph g(6);

    g.addEdge(1, 2, 4);
    g.addEdge(1, 3, 3);
    g.addEdge(2, 4, 2);
    g.addEdge(3, 4, 1);
    g.addEdge(3, 5, 5);
    g.addEdge(4, 5, 2);
    g.addEdge(4, 6, 4);
    g.addEdge(5, 6, 1);

    Coordinator system(g);

    // Initial UAV data
    system.addUAV(UAV("UAV-A", 1, 100));
    system.addUAV(UAV("UAV-B", 3, 80));
    system.addUAV(UAV("UAV-C", 5, 60));

    // Priority: 5 = most urgent
    system.addMission(
        Mission(101, 6, 3, "Medical Emergency"));
    system.addMission(
        Mission(102, 4, 2, "Person Missing"));
    system.addMission(
        Mission(103, 5, 1, "Supply Delivery"));

    system.showDrones();
    system.processMissions();

    // Demonstrate changing conditions
    system.simulateLowBattery("UAV-A", 20);
    system.simulateFailure("UAV-B");

    cout << "\n======= FINAL UAV STATUS =======\n";
    system.showDrones();

    cout << "\nSimulation completed.\n";
    return 0;
}
